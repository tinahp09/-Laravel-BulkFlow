{
  "name": "laravel-bulkflow-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/vue-bulkflow",
    "demo/vue-app"
  ],
  "scripts": {
    "test:vue": "npm --workspace @bulkflow/vue run test",
    "build:vue": "npm --workspace @bulkflow/vue run build",
    "dev:frontend": "npm --workspace @bulkflow/demo-vue run dev",
    "build:demo": "npm --workspace @bulkflow/demo-vue run build"
  },
  "engines": {
    "node": ">=20"
  }
}
