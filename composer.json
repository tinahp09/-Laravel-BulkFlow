{
  "name": "bulkflow/laravel-bulkflow",
  "description": "Streaming bulk imports and exports for Laravel.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/tinahp09/-Laravel-BulkFlow",
  "support": {
    "issues": "https://github.com/tinahp09/-Laravel-BulkFlow/issues",
    "source": "https://github.com/tinahp09/-Laravel-BulkFlow"
  },
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0 || ^13.0",
    "openspout/openspout": "^4.28"
  },
  "require-dev": {
    "laravel/pint": "^1.32",
    "league/flysystem-aws-s3-v3": "^3.35",
    "orchestra/testbench": "^9.0 || ^10.0",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "BulkFlow\\": "packages/laravel-bulkflow/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BulkFlow\\Tests\\": "packages/laravel-bulkflow/tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "BulkFlow\\BulkFlowServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/demo",
      "/doc",
      "/packages/vue-bulkflow",
      "/node_modules",
      "/package-lock.json",
      "/package.json",
      "/private",
      "/packages/laravel-bulkflow/vendor",
      "/packages/laravel-bulkflow/.phpunit.result.cache",
      "/packages/laravel-bulkflow/composer.lock"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
